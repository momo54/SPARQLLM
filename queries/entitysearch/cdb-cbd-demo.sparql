## Demo: CDB Provider CBD
## slm-run --config config.ini -f queries/entitysearch/cdb-cbd-demo.sparql --debug

PREFIX schema: <https://schema.org/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ggf:    <http://ggf.org/>
PREFIX prov:   <http://www.w3.org/ns/prov#>

#SELECT ?label ?desc ?p ?o ?tool ?duration
SELECT ?s ?p ?o
WHERE {
  VALUES ?entity { <http://www.wikidata.org/entity/Q1057464> }
  BIND(ggf:WIKIDATA-CBD-CDB(?entity, "en") AS ?gCBD)

  GRAPH ?gCBD {
    ?s ?p ?o .
    # OPTIONAL { ?entity rdfs:label ?label }
    # OPTIONAL { ?entity schema:description ?desc }
    # OPTIONAL { ?entity ?p ?o FILTER(!isBlank(?o)) }
  }

#   GRAPH ?g {
#     ?act a prov:Activity ;
#          schema:duration ?duration ;
#          prov:wasAssociatedWith ?tool .
#   }
}
ORDER BY ?p
