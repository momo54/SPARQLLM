## End-to-end demo: utterance -> LLM mentions -> Wikidata search -> LLM-RANK-ENTITIES
##
## Commande :
## slm-run --config config.ini -f queries/utterance-entity-linking.sparql --debug

PREFIX schema: <https://schema.org/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ggf:    <http://ggf.org/>
PREFIX cand:   <http://example.org/cand#>

SELECT  ?utterance ?mentionText ?chosenEntity ?chosenLabel
WHERE {
  BIND("I would like to book the Hilton in Paris"@en AS ?utterance)
  BIND( CONCAT(
      """You are an entity mention extractor,
      Text: """, STR(?utterance), """
    - For each mention, create a node of type cand:Mention with:
    - cand:mentionText: the exact text span of the mention (string).
    Return ONLY a valid JSON-LD document of the form:
    {
      @context: { cand: http://example.org/cand# },
      @graph: [
        { @type: cand:Mention, cand:mentionText: ... }
      ],
    }"""    )    AS ?mPrompt  )
  BIND(ggf:LLM(?mPrompt) AS ?gMentions)
  GRAPH ?gMentions {
     ?m  cand:mentionText ?mentionText .
  }
   BIND(ggf:WIKIDATA-SEARCH-ENTITY(?mentionText, "en", 5) AS ?gSearchMention)
   BIND(ggf:LLM-RANK-ENTITIES(?utterance, ?gSearchMention) AS ?gRank)
   GRAPH ?gRank {
     ?choice a cand:ChosenEntity ;
             cand:mentionText ?mentionText ;
             cand:entity ?chosenEntity ;
             cand:label ?chosenLabel .
   }
}
ORDER BY ?mentionText
