PREFIX ggf:  <http://ggf.org/>
PREFIX cand: <http://example.org/cand#>

SELECT ?rank ?candidateLabel ?viaProperty2 ?viaDirection2 ?hop1Label ?viaProperty1 ?viaDirection1
WHERE {
  VALUES (?question) { ( "the screenwriter of [Taxidermia] also wrote which films" ) }

  BIND(ggf:LOAD("./data/metaqa/MetaQA/kb.ttl") AS ?gMeta)
  BIND(ggf:BEAM-METAQA-SEARCH(?question, ?gMeta, 2, 100, 200) AS ?gBeam)
  BIND(ggf:BEAM-BEST(?gBeam, 100) AS ?gRanked)

  GRAPH ?gRanked {
    ?rankedNode cand:rank ?rank ;
                cand:entity ?candidate ;
                cand:label ?candidateLabel .
  }

  GRAPH ?gBeam {
    ?leaf cand:entity ?candidate ;
          cand:viaProperty ?viaProperty2 ;
          cand:viaDirection ?viaDirection2 ;
          cand:parent ?hop1 .

    ?hop1 cand:label ?hop1Label ;
          cand:viaProperty ?viaProperty1 ;
          cand:viaDirection ?viaDirection1 ;
          cand:parent ?hop0 .

    ?hop0 cand:label "Taxidermia" .
  }
}
ORDER BY ?rank
LIMIT 50
