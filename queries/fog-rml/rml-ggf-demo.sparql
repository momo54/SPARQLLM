PREFIX ggf: <http://ggf.org/>

SELECT ?s ?p ?o
WHERE {
  BIND("""
  [
    {"id": 1, "name": "Alice", "tot": "titi"},
    {"iid": 2, "name": "Bob", "tt": "toto"}
  ]
  """ AS ?jsonString)

  BIND("./data/rml-demo/people.rml.ttl" AS ?rmlFile)
  BIND(ggf:RML(?jsonString, ?rmlFile) AS ?g)

  GRAPH ?g {
    ?s ?p ?o .
  }
}
ORDER BY ?s ?p ?o
