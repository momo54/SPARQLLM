    mqqa:goldAnswer "1981" .

<urn:metaqa:question/q6>
    a mqqa:Question ;
    mqqa:id "q6" ;
    mqqa:text "the movies written by [John Alan Schwartz] starred who" ;
    mqqa:goldAnswer "Michael Carr" .

<urn:metaqa:question/q7>
    a mqqa:Question ;
    mqqa:id "q7" ;
    mqqa:text "what types are the movies directed by [Olaf de Fleur Johannesson]" ;
    mqqa:goldAnswer "Comedy" .

<urn:metaqa:question/q8>
    a mqqa:Question ;
    mqqa:id "q8" ;
    mqqa:text "who are the directors of the films written by [Laura Kerr]" ;
    mqqa:goldAnswer "H.C. Potter" .

<urn:metaqa:question/q9>
    a mqqa:Question ;
    mqqa:id "q9" ;
    mqqa:text "which person directed the movies written by [John Godey]" ;
    mqqa:goldAnswer "Walter Hill" ;
