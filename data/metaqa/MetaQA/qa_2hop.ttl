<urn:metaqa:question/q1>
    a mqqa:Question ;
    mqqa:id "q1" ;
    mqqa:text "what are the languages spoken in the films directed by [Joel Zwick]" ;
    mqqa:goldAnswer "Greek" .

<urn:metaqa:question/q2>
    a mqqa:Question ;
    mqqa:id "q2" ;
    mqqa:text "the films acted by [Sharon Tate] were released in which years" ;
    mqqa:goldAnswer "1967" ;
    mqqa:goldAnswer "1968" .

<urn:metaqa:question/q3>
    a mqqa:Question ;
    mqqa:id "q3" ;
    mqqa:text "when did the films written by [Anthony Mann] release" ;
    mqqa:goldAnswer "1949" ;
    mqqa:goldAnswer "1947" .

<urn:metaqa:question/q4>
    a mqqa:Question ;
    mqqa:id "q4" ;
    mqqa:text "what genres do the movies directed by [Clark Gregg] fall under" ;
    mqqa:goldAnswer "Drama" ;
    mqqa:goldAnswer "Comedy" .

<urn:metaqa:question/q5>
