PREFIX ment:   <http://metaqa.org/entity/>
PREFIX ggf:    <http://ggf.org/>
PREFIX cand:   <http://example.org/cand#>
PREFIX schema: <https://schema.org/>
PREFIX sh:     <http://www.w3.org/ns/shacl#>

# Validate an expanded neighborhood graph against an intentionally too strict
# shape, so that the report contains explicit SHACL violations.
#
# Run:
# python -m SPARQLLM.cli.slm --config config.ini \
#   -f xp-ggf-script/queries/metaqa-expand-shacl-violation.sparql \
#   --load data/metaqa/MetaQA/kb.ttl --format turtle \
#   -o xp-ggf-script/out/metaqa_expand_shacl_violation.csv

SELECT ?conforms ?focusNode ?resultPath ?message ?severity
WHERE {
  BIND(ggf:EXPAND(ment:taxidermia, 1, "both") AS ?gExpanded)
  BIND(ggf:SHACL-VALIDATE(?gExpanded, "xp-ggf-script/shapes/metaqa-expand-movie-strict.shacl.ttl") AS ?gReport)

  GRAPH ?gReport {
    ?meta a cand:ShaclReport ;
          cand:conforms ?conforms ;
          schema:text ?reportText .

    OPTIONAL {
      ?vr a sh:ValidationResult ;
          sh:focusNode ?focusNode .
      OPTIONAL { ?vr sh:resultPath ?resultPath . }
      OPTIONAL { ?vr sh:resultMessage ?message . }
      OPTIONAL { ?vr sh:resultSeverity ?severity . }
    }
  }
}
ORDER BY ?focusNode ?resultPath ?message
